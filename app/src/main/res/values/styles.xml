<resources xmlns:tools="http://schemas.android.com/tools">

	<!--AlertDialog-->

	<style name="ThemeOverlay.Hanten.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
		<item name="alertDialogStyle">@style/AlertDialog.Hanten</item>
		<item name="dialogCornerRadius">@dimen/m3_alert_dialog_corner_size</item>
	</style>

	<style name="AlertDialog.Hanten" parent="MaterialAlertDialog.Material3">
		<item name="android:background">@drawable/m3_popup_background</item>
	</style>

	<!-- Bottom sheet -->

	<style name="ThemeOverlay.Hanten.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
		<item name="android:windowAnimationStyle">@style/Animation.Hanten.BottomSheetDialog</item>
		<item name="bottomSheetStyle">@style/Widget.Hanten.BottomSheet.Modal</item>
	</style>

	<style name="ThemeOverlay.Hanten.SideSheetDialog" parent="ThemeOverlay.Material3.SideSheetDialog" />

	<style name="Widget.Hanten.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
		<item name="paddingBottomSystemWindowInsets">false</item>
	</style>

	<style name="Widget.Hanten.BottomSheet.DragHandle" parent="Widget.Material3.BottomSheet.DragHandle">
		<!-- Fix weird bottom padding -->
		<item name="android:paddingBottom">0dp</item>
	</style>

	<style name="Widget.Hanten.Spinner.DropDown" parent="Widget.AppCompat.Spinner.DropDown">
		<item name="android:popupBackground">@drawable/m3_spinner_popup_background</item>
		<item name="android:elevation">8dp</item>
		<item name="android:popupElevation">3dp</item>
	</style>

	<style name="Animation.Hanten.BottomSheetDialog" parent="Animation.AppCompat.Dialog">
		<item name="android:windowEnterAnimation">@anim/bottom_sheet_slide_in</item>
		<item name="android:windowExitAnimation">@anim/bottom_sheet_slide_out</item>
	</style>

	<!-- Widget styles -->

	<style name="Widget.Hanten.SearchView" parent="@style/Widget.AppCompat.SearchView">
		<item name="iconifiedByDefault">false</item>
		<item name="searchIcon">@null</item>
		<item name="queryBackground">@null</item>
		<item name="android:textAppearance">@style/TextAppearance.Hanten.SearchView</item>
		<item name="android:textSize">18sp</item>
	</style>

	<style name="Widget.Hanten.CircularProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
		<item name="trackCornerRadius">@dimen/mtrl_progress_indicator_full_rounded_corner_radius</item>
	</style>

	<style name="Widget.Hanten.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
		<item name="trackCornerRadius">@dimen/mtrl_progress_indicator_full_rounded_corner_radius</item>
	</style>

	<style name="Widget.Hanten.Chip" parent="Widget.Material3.Chip.Suggestion" />

	<style name="Widget.Hanten.Chip.Filter" parent="Widget.Material3.Chip.Filter" />

	<style name="Widget.Hanten.Chip.Assist" parent="Widget.Material3.Chip.Assist" />

	<style name="Widget.Hanten.Chip.Dropdown" parent="Widget.Material3.Chip.Assist">
		<item name="closeIconVisible">true</item>
		<item name="closeIcon">@drawable/ic_expand_more</item>
		<item name="chipIconVisible">true</item>
	</style>

	<style name="Widget.Hanten.Button.More" parent="Widget.Material3.Button.TextButton">
		<item name="android:minWidth">48dp</item>
	</style>

	<style name="Widget.Hanten.Button.More.Small">
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:minHeight">42dp</item>
		<item name="android:gravity">center</item>
		<item name="iconPadding">0dp</item>
		<item name="android:minWidth">48dp</item>
	</style>

	<style name="Widget.Hanten.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
		<item name="android:checkable">true</item>
		<item name="android:textAlignment">textStart</item>
		<item name="iconPadding">16dp</item>
	</style>

	<style name="Widget.Hanten.ToggleButton.Vertical">
		<item name="android:textAlignment">center</item>
		<item name="iconPadding">2dp</item>
		<item name="android:singleLine">false</item>
		<item name="iconGravity">top</item>
		<item name="android:paddingTop">12dp</item>
		<item name="android:paddingBottom">10dp</item>
		<item name="android:paddingStart">6dp</item>
		<item name="android:paddingEnd">6dp</item>
		<item name="android:elegantTextHeight">false</item>
		<item name="shapeAppearance">?shapeAppearanceCornerMedium</item>
	</style>

	<style name="Widget.Hanten.Slider.Wide" parent="Widget.Material3.Slider">
		<item name="thumbHeight">48dp</item>
		<item name="trackCornerSize">12dp</item>
		<item name="trackHeight">40dp</item>
	</style>

	<style name="Widget.Hanten.RecyclerView" parent="">
		<item name="android:scrollbarStyle">outsideOverlay</item>
		<item name="android:clipToPadding">false</item>
	</style>

	<style name="Widget.Hanten.FastScroller" parent="">
		<item name="thumbColor">?colorTertiary</item>
		<item name="bubbleColor">?colorTertiary</item>
		<item name="bubbleTextColor">?colorOnTertiary</item>
		<item name="trackColor">?colorOutline</item>
		<item name="bubbleSize">small</item>
		<item name="scrollerOffset">@dimen/grid_spacing_outer</item>
	</style>

	<style name="Widget.Hanten.DotIndicator" parent="" />

	<style name="Widget.Hanten.BadgeView" parent="">
		<item name="android:textColor">@macro/m3_comp_badge_large_label_text_color</item>
		<item name="android:minWidth">@dimen/m3_badge_with_text_size</item>
		<item name="android:minHeight">@dimen/m3_badge_with_text_size</item>
		<item name="android:textAppearance">@macro/m3_comp_badge_large_label_text_type</item>
		<item name="android:gravity">center</item>
		<item name="shapeAppearance">@style/ShapeAppearance.M3.Comp.Badge.Shape</item>
		<item name="backgroundColor">?attr/colorError</item>
		<item name="android:elegantTextHeight">false</item>
		<item name="singleLine">true</item>
		<item name="android:outlineProvider">background</item>
	</style>

	<style name="Widget.Hanten.ListItemTextView" parent="">
		<item name="android:textColor">@color/list_item_text_color</item>
		<item name="backgroundFillColor">@color/list_item_background_color</item>
		<item name="checkedDrawableStart">@drawable/ic_check</item>
		<item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Material3.NavigationView.Item</item>
		<item name="android:gravity">center_vertical|start</item>
		<item name="android:insetRight">6dp</item>
		<item name="android:insetLeft">6dp</item>
		<item name="android:insetTop">2dp</item>
		<item name="android:insetBottom">2dp</item>
		<item name="android:textAppearance">?textAppearanceListItem</item>
		<item name="android:minHeight">?android:listPreferredItemHeightSmall</item>
		<item name="android:drawablePadding">?android:listPreferredItemPaddingStart</item>
		<item name="android:paddingStart">?android:listPreferredItemPaddingStart</item>
		<item name="android:paddingEnd">?android:listPreferredItemPaddingEnd</item>
	</style>

	<style name="Widget.Hanten.TwoLinesItemView" parent="">
		<item name="backgroundFillColor">@color/list_item_background_color</item>
		<item name="shapeAppearance">?attr/shapeAppearanceCornerLarge</item>
		<item name="android:insetRight">6dp</item>
		<item name="android:insetLeft">6dp</item>
		<item name="android:insetTop">2dp</item>
		<item name="android:insetBottom">2dp</item>
		<item name="android:orientation">horizontal</item>
		<item name="android:textColor">@color/list_item_text_color</item>
		<item name="titleTextAppearance">?attr/textAppearanceTitleSmall</item>
		<item name="subtitleTextAppearance">?attr/textAppearanceBodySmall</item>
	</style>

	<style name="Widget.Hanten.ExploreButton" parent="Widget.Material3.Button.ElevatedButton.Icon">
		<item name="android:minHeight">56dp</item>
		<item name="android:singleLine">true</item>
		<item name="shapeAppearance">?shapeAppearanceCornerExtraLarge</item>
		<item name="android:ellipsize">marquee</item>
		<item name="android:marqueeRepeatLimit">marquee_forever</item>
		<item name="iconSize">22dp</item>
		<item name="iconPadding">16dp</item>
		<item name="iconGravity">start</item>
		<item name="iconTint">?attr/colorPrimary</item>
		<item name="android:textColor">?attr/colorPrimary</item>
		<item name="android:insetTop">2dp</item>
		<item name="android:insetBottom">2dp</item>
		<item name="android:gravity">start|center_vertical</item>
		<item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
		<!-- Hack. Removing shadow. For AMOLED -->
		<item name="android:outlineProvider">none</item>
		<item name="elevation">24dp</item>
	</style>

	<style name="Widget.Hanten.TextView.Indicator" parent="Widget.MaterialComponents.TextView">
		<item name="android:drawablePadding">12dp</item>
		<item name="android:gravity">center_vertical</item>
		<item name="android:textAppearance">?textAppearanceLabelMedium</item>
	</style>

	<style name="Widget.Hanten.TextView.Badge" parent="Widget.MaterialComponents.TextView">
		<item name="android:background">@drawable/bg_chip</item>
		<item name="android:gravity">center</item>
		<item name="android:textAlignment">center</item>
		<item name="android:paddingStart">4dp</item>
		<item name="android:paddingEnd">4dp</item>
		<item name="android:paddingTop">2dp</item>
		<item name="android:paddingBottom">2dp</item>
		<item name="android:textAppearance">?textAppearanceLabelMedium</item>
		<item name="android:textColor">?colorOnBackground</item>
	</style>

	<style name="Widget.Hanten.TextView.ContentType" parent="Widget.MaterialComponents.TextView">
		<item name="android:background">@drawable/bg_content_type_banner</item>
		<item name="android:gravity">center</item>
		<item name="android:textAlignment">center</item>
		<item name="android:textAppearance">?textAppearanceLabelSmall</item>
		<item name="android:textSize">8sp</item>
		<item name="android:textColor">?colorOnBackground</item>
		<item name="android:includeFontPadding">false</item>
		<item name="android:maxLines">1</item>
		<item name="android:maxWidth">56dp</item>
		<item name="android:ellipsize">end</item>
		<item name="android:paddingStart">4dp</item>
		<item name="android:paddingEnd">5dp</item>
		<item name="android:paddingTop">1dp</item>
		<item name="android:paddingBottom">1dp</item>
	</style>

	<style name="Widget.Hanten.ImageView.Cover" parent="Widget.MaterialComponents.ShapeableImageView">
		<item name="aspectRationHeight">18</item>
		<item name="aspectRationWidth">13</item>
		<item name="android:scaleType">centerCrop</item>
		<item name="allowRgb565">true</item>
		<item name="trimImage">true</item>
	</style>

	<style name="ThemeOverlay.Hanten.MainToolbar" parent="">
		<item name="colorControlHighlight">@color/selector_overlay</item>
	</style>

	<style name="ThemeOverlay.Hanten.ActionMode" parent="">
		<item name="colorOnSurface">?colorPrimary</item>
		<item name="colorControlNormal">?colorPrimary</item>
	</style>

	<!-- TextAppearance -->

	<style name="TextAppearance.Hanten.SearchView" parent="TextAppearance.Material3.SearchBar">
		<item name="android:textColor">?attr/colorOnSurfaceVariant</item>
	</style>

	<style name="TextAppearance.Widget.Menu" parent="TextAppearance.AppCompat.Menu">
		<item name="android:textColor">?attr/colorOnBackground</item>
	</style>

	<style name="TextAppearance.Hanten.Preference.Secondary" parent="TextAppearance.Hanten.BodySmall" />

	<style name="TextAppearance.Hanten.GridTitle" parent="TextAppearance.Hanten.TitleSmall" />

	<style name="TextAppearance.Hanten.GridTitle.Small" parent="TextAppearance.Hanten.TitleSmall">
		<item name="android:textSize">12sp</item>
		<item name="android:letterSpacing">0.00714286</item>
		<item name="lineHeight">14sp</item>
		<item name="android:lineHeight" tools:ignore="NewApi">14sp</item>
	</style>

	<!-- Shapes -->

	<!-- Larger cover on the title card -->
	<style name="ShapeAppearanceOverlay.Hanten.Cover.Details" parent="">
		<item name="cornerSize">16dp</item>
	</style>

	<style name="ShapeAppearanceOverlay.Hanten.Cover" parent="">
		<item name="cornerSize">12dp</item>
	</style>

	<style name="ShapeAppearanceOverlay.Hanten.Cover.Medium" parent="">
		<item name="cornerSize">8dp</item>
	</style>

	<style name="ShapeAppearanceOverlay.Hanten.Cover.Small" parent="">
		<item name="cornerSize">4dp</item>
	</style>

	<style name="ShapeAppearanceOverlay.Hanten.Circle" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">50%</item>
	</style>

	<style name="ShapeAppearanceOverlay.Material3.Corner.None" parent="">
		<item name="cornerSizeBottomLeft">0dp</item>
		<item name="cornerSizeBottomRight">0dp</item>
		<item name="cornerSizeTopLeft">0dp</item>
		<item name="cornerSizeTopRight">0dp</item>
	</style>

	<!--Preferences-->

	<style name="PreferenceThemeOverlay.Hanten">
		<item name="singleLineTitle">false</item>
	</style>

	<style name="Preference.Slider" parent="Preference.SeekBarPreference.Material">
		<item name="android:layout">@layout/preference_slider</item>
	</style>

	<style name="Preference.MultiAutoCompleteTextView" parent="Preference.DialogPreference.EditTextPreference.Material">
		<item name="android:dialogLayout">@layout/preference_dialog_multiautocompletetextview</item>
	</style>

	<style name="Preference.AutoCompleteTextView" parent="Preference.DialogPreference.EditTextPreference.Material">
		<item name="android:dialogLayout">@layout/preference_dialog_autocompletetextview</item>
	</style>

	<style name="Preference.SwitchPreferenceCompat.M3" parent="Preference.SwitchPreferenceCompat.Material">
		<item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
	</style>

	<style name="Preference.ThemeChooser" parent="Preference.Material">
		<item name="android:layout">@layout/preference_theme</item>
		<item name="android:selectable">false</item>
	</style>

	<!-- Drawable -->

	<style name="ProgressDrawable">
		<item name="android:fillAlpha">1</item>
		<item name="android:fillColor">?attr/colorPrimary</item>
		<item name="android:strokeColor">?attr/colorSurfaceVariant</item>
		<item name="android:textColor">?attr/colorOnPrimary</item>
		<item name="strokeWidth">4dp</item>
		<item name="android:textSize">9sp</item>
		<item name="autoFitTextSize">true</item>
	</style>

	<style name="FaviconDrawable">
		<item name="backgroundColor">?colorBackgroundFloating</item>
		<item name="strokeColor">?colorOutline</item>
	</style>

	<style name="FaviconDrawable.Small">
		<item name="strokeWidth">1dp</item>
		<item name="cornerSize">8dp</item>
	</style>

	<style name="FaviconDrawable.Large">
		<item name="strokeWidth">1dp</item>
		<item name="cornerSize">12dp</item>
	</style>

	<style name="FaviconDrawable.Chip">
		<item name="strokeWidth">1px</item>
		<item name="cornerSize">@dimen/chip_icon_corner</item>
		<item name="drawableSize">@dimen/m3_chip_icon_size</item>
	</style>

	<!-- Hanten 3.0 look (see the "Hanten UI" mockup) -->
	<style name="ShapeAppearance.Hanten.Small" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">10dp</item>
	</style>

	<style name="ShapeAppearance.Hanten.Medium" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">16dp</item>
	</style>

	<style name="ShapeAppearance.Hanten.Large" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">20dp</item>
	</style>

	<style name="ShapeAppearance.Hanten.ExtraLarge" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">28dp</item>
	</style>

	<style name="Widget.Hanten.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
		<item name="backgroundTint">?colorSurfaceContainer</item>
		<item name="itemActiveIndicatorStyle">@style/Widget.Hanten.BottomNavigationView.ActiveIndicator</item>
		<item name="itemIconTint">@color/nav_item_hanten</item>
		<item name="itemTextColor">@color/nav_item_hanten</item>
		<item name="itemTextAppearanceActive">?textAppearanceLabelMedium</item>
		<item name="itemTextAppearanceActiveBoldEnabled">true</item>
	</style>

	<style name="Widget.Hanten.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
		<item name="android:color">?colorPrimaryContainer</item>
	</style>

	<style name="Widget.Hanten.CardView" parent="Widget.Material3.CardView.Filled">
		<item name="cardBackgroundColor">?colorSurfaceContainer</item>
		<item name="shapeAppearance">?shapeAppearanceCornerLarge</item>
	</style>

	<!-- Big screen title above the search bar on the main tabs -->
	<style name="TextAppearance.Hanten.ScreenTitle" parent="TextAppearance.Hanten.HeadlineMedium">
		<item name="android:textStyle">bold</item>
		<item name="android:textColor">?colorOnSurface</item>
		<item name="android:letterSpacing">-0.01</item>
		<item name="android:textSize">26sp</item>
	</style>


	<!-- Hanten 3.0: pill segmented control (Library Folders / All titles) -->
	<style name="Widget.Hanten.SegmentedGroup" parent="">
		<item name="android:background">@drawable/bg_segmented</item>
		<item name="android:padding">4dp</item>
		<item name="android:spacing">4dp</item>
		<item name="innerCornerSize">10dp</item>
		<item name="shapeAppearance">@style/ShapeAppearance.Hanten.Segment</item>
	</style>

	<style name="ShapeAppearance.Hanten.Segment" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">10dp</item>
	</style>

	<style name="Widget.Hanten.Button.Segment" parent="Widget.Material3.Button.TextButton">
		<item name="backgroundTint">@color/segment_button_bg</item>
		<item name="android:textColor">@color/segment_button_text</item>
		<item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
		<item name="android:minHeight">40dp</item>
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="shapeAppearance">@style/ShapeAppearance.Hanten.Segment</item>
		<item name="rippleColor">?attr/colorControlHighlight</item>
	</style>

	<style name="ShapeAppearanceOverlay.Hanten.FolderCover" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">8dp</item>
	</style>

	<style name="Widget.Hanten.Button.Segment.Icon">
		<item name="iconGravity">textStart</item>
		<item name="iconPadding">0dp</item>
		<item name="iconSize">20dp</item>
		<item name="iconTint">@color/segment_button_text</item>
		<item name="android:minWidth">0dp</item>
		<item name="android:minHeight">34dp</item>
		<item name="android:paddingStart">0dp</item>
		<item name="android:paddingEnd">0dp</item>
	</style>

	<style name="Widget.Hanten.TextView.ProfileSection" parent="">
		<item name="android:layout_marginTop">20dp</item>
		<item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
		<item name="android:textColor">?attr/colorOnSurface</item>
	</style>

	<!-- Hanten 3.0 main header: menu items drawn as 44dp round buttons -->
	<style name="ThemeOverlay.Hanten.HeaderActions" parent="">
		<item name="actionButtonStyle">@style/Widget.Hanten.HeaderAction</item>
		<item name="actionOverflowButtonStyle">@style/Widget.Hanten.HeaderAction.Overflow</item>
		<item name="colorControlNormal">?attr/colorOnSurface</item>
	</style>

	<style name="Widget.Hanten.HeaderAction" parent="Widget.AppCompat.ActionButton">
		<item name="android:background">@drawable/bg_header_action</item>
		<item name="android:minWidth">50dp</item>
		<item name="android:maxWidth">50dp</item>
		<item name="android:paddingStart">13dp</item>
		<item name="android:paddingEnd">13dp</item>
	</style>

	<style name="Widget.Hanten.HeaderAction.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
		<item name="android:background">@drawable/bg_header_action</item>
		<item name="android:minWidth">50dp</item>
		<item name="android:maxWidth">50dp</item>
		<item name="android:paddingStart">13dp</item>
		<item name="android:paddingEnd">13dp</item>
	</style>

	<style name="Widget.Hanten.HeaderButton" parent="">
		<item name="android:layout_width">44dp</item>
		<item name="android:layout_height">44dp</item>
		<item name="android:background">@drawable/bg_header_button</item>
		<item name="android:scaleType">center</item>
		<item name="tint">?attr/colorOnSurface</item>
	</style>
</resources>
