<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<!-- Hanten 3.0: search all sources (opens the app search with suggestions) -->
	<TextView
		android:id="@+id/button_search_all"
		android:layout_width="0dp"
		android:layout_height="52dp"
		android:layout_marginBottom="14dp"
		android:background="@drawable/bg_search_field"
		android:drawablePadding="10dp"
		android:focusable="true"
		android:gravity="center_vertical"
		android:paddingHorizontal="16dp"
		android:text="@string/catalog_search_hint"
		android:textAppearance="?textAppearanceBodyLarge"
		android:textColor="?colorOnSurfaceVariant"
		app:drawableStartCompat="@drawable/ic_search"
		app:drawableTint="?colorOnSurfaceVariant"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_local"
		style="@style/Widget.Hanten.ExploreButton"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:text="@string/explore_on_device"
		app:icon="@drawable/ic_storage" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_suggestions"
		style="@style/Widget.Hanten.ExploreButton"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:text="@string/suggestions"
		app:icon="@drawable/ic_suggestion" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_random"
		style="@style/Widget.Hanten.ExploreButton"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:text="@string/random"
		app:icon="@drawable/ic_dice" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_manage_sources"
		style="@style/Widget.Hanten.ExploreButton"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:text="@string/explore_sources"
		app:icon="@drawable/ic_settings" />

	<androidx.constraintlayout.helper.widget.Flow
		android:id="@+id/flow"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:constraint_referenced_ids="button_suggestions,button_random,button_local,button_manage_sources"
		android:layout_marginTop="14dp"
		app:flow_horizontalGap="8dp"
		app:flow_maxElementsWrap="@integer/explore_buttons_columns"
		app:flow_verticalGap="8dp"
		app:flow_wrapMode="aligned"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/button_search_all" />

</androidx.constraintlayout.widget.ConstraintLayout>
