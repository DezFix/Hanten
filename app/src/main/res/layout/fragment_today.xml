<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/swipeRefresh"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
	android:id="@+id/scrollView"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:clipToPadding="false">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingTop="8dp"
		android:paddingBottom="96dp">

		<!-- seasonal greeting (hanami, Tanabata, Halloween, New Year): easter egg, hidden the rest of the year -->
		<TextView
			android:id="@+id/text_season"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="16dp"
			android:layout_marginBottom="10dp"
			android:background="@drawable/bg_season_chip"
			android:paddingHorizontal="14dp"
			android:paddingVertical="6dp"
			android:textAppearance="?textAppearanceLabelLarge"
			android:textColor="?colorOnTertiaryContainer"
			android:visibility="gone"
			tools:text="🌸 Сезон ханами"
			tools:visibility="visible" />

		<com.google.android.material.card.MaterialCardView
			android:id="@+id/card_continue"
			style="@style/Widget.Hanten.CardView"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="16dp"
			android:visibility="gone"
			app:cardBackgroundColor="?colorSurfaceContainerHigh"
			app:cardCornerRadius="24dp"
			tools:visibility="visible">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:padding="16dp">

				<com.google.android.material.card.MaterialCardView
					android:layout_width="96dp"
					android:layout_height="136dp"
					app:cardCornerRadius="14dp"
					app:cardElevation="0dp"
					app:strokeWidth="0dp">

					<hanten.wre.app.image.ui.CoverImageView
						android:id="@+id/image_continue_cover"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:scaleType="centerCrop" />
				</com.google.android.material.card.MaterialCardView>

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="16dp"
					android:minHeight="136dp"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/_continue"
						android:textAllCaps="true"
						android:textAppearance="?textAppearanceLabelMedium"
						android:textColor="?colorPrimary"
						android:textStyle="bold" />

					<TextView
						android:id="@+id/text_continue_title"
						android:layout_width="match_parent"
						android:layout_height="44dp"
						android:layout_marginTop="4dp"
						android:ellipsize="end"
						android:gravity="center_vertical"
						android:maxLines="2"
						app:autoSizeMaxTextSize="16sp"
						app:autoSizeMinTextSize="12sp"
						app:autoSizeStepGranularity="1sp"
						app:autoSizeTextType="uniform"
						android:textAppearance="?textAppearanceTitleMedium"
						android:textStyle="bold"
						tools:text="@tools:sample/lorem[3]" />

					<TextView
						android:id="@+id/text_continue_subtitle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:singleLine="true"
						android:textAppearance="?textAppearanceBodyMedium"
						android:textColor="?colorOnSurfaceVariant"
						tools:text="ReadManga · 72%" />

					<com.google.android.material.progressindicator.LinearProgressIndicator
						android:id="@+id/progress_continue"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						app:indicatorTrackGapSize="0dp"
						app:trackColor="?colorOutlineVariant"
						app:trackCornerRadius="2dp"
						app:trackStopIndicatorSize="0dp"
						app:trackThickness="4dp" />

					<Space
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_continue"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						app:cornerRadius="14dp"
						android:text="@string/read" />
				</LinearLayout>
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<!-- one-time question for existing users: anonymous error reports -->
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/card_reports"
			style="@style/Widget.Hanten.CardView"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="16dp"
			android:layout_marginTop="12dp"
			android:visibility="gone"
			app:cardBackgroundColor="?colorTertiaryContainer"
			app:cardCornerRadius="22dp"
			tools:visibility="visible">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingTop="14dp"
				android:paddingEnd="16dp"
				android:paddingBottom="10dp">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/reports_title"
					android:textAppearance="?textAppearanceTitleMedium"
					android:textColor="?colorOnTertiaryContainer"
					android:textStyle="bold" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:text="@string/reports_card_text"
					android:textAppearance="?textAppearanceBodyMedium"
					android:textColor="?colorOnTertiaryContainer" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:gravity="end|center_vertical"
					android:orientation="horizontal">

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_reports_no"
						style="@style/Widget.Material3.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/reports_no"
						android:textColor="?colorOnTertiaryContainer" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_reports_yes"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="8dp"
						android:text="@string/reports_yes"
						app:cornerRadius="14dp" />
				</LinearLayout>
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<!-- Ko-fi: 14 days after the first launch; «Не сейчас» = again in 60 days, the cross = never -->
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/card_kofi"
			style="@style/Widget.Hanten.CardView"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="16dp"
			android:layout_marginTop="12dp"
			android:visibility="gone"
			app:cardBackgroundColor="?colorSecondaryContainer"
			app:cardCornerRadius="22dp"
			tools:visibility="visible">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingStart="16dp"
				android:paddingTop="8dp"
				android:paddingEnd="8dp"
				android:paddingBottom="12dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<FrameLayout
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:background="@drawable/bg_donate_icon">

						<ImageView
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:layout_gravity="center"
							android:importantForAccessibility="no"
							android:src="@drawable/ic_heart"
							app:tint="?colorOnPrimary" />
					</FrameLayout>

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="12dp"
						android:layout_weight="1"
						android:text="@string/kofi_banner_title"
						android:textAppearance="?textAppearanceTitleMedium"
						android:textColor="?colorOnSecondaryContainer"
						android:textStyle="bold" />

					<ImageButton
						android:id="@+id/button_kofi_close"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:background="?selectableItemBackgroundBorderless"
						android:contentDescription="@string/kofi_banner_never"
						android:src="@drawable/ic_close_small"
						app:tint="?colorOnSecondaryContainer" />
				</LinearLayout>

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:layout_marginEnd="8dp"
					android:text="@string/kofi_banner_text"
					android:textAppearance="?textAppearanceBodyMedium"
					android:textColor="?colorOnSecondaryContainer" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:layout_marginEnd="8dp"
					android:gravity="end|center_vertical"
					android:orientation="horizontal">

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_kofi_later"
						style="@style/Widget.Material3.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/kofi_banner_later"
						android:textColor="?colorOnSecondaryContainer" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_kofi_support"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="8dp"
						android:text="@string/kofi_banner_support"
						app:cornerRadius="14dp" />
				</LinearLayout>
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>

		<LinearLayout
			android:id="@+id/layout_updates_header"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingEnd="8dp">

			<TextView
				android:id="@+id/text_updates_title"
				style="@style/TextAppearance.Hanten.Today.Section"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/new_chapters" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_updates_all"
				style="@style/Widget.Material3.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="@string/today_all" />
		</LinearLayout>

		<TextView
			android:id="@+id/text_updates_empty"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="16dp"
			android:text="@string/today_no_new_chapters"
			android:textAppearance="?textAppearanceBodyMedium"
			android:textColor="?colorOnSurfaceVariant"
			android:visibility="gone"
			tools:visibility="visible" />

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recycler_updates"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:clipToPadding="false"
			android:orientation="horizontal"
			android:paddingHorizontal="10dp"
			app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

		<!-- «Скоро выйдет»: the nearest expected chapters (forecast from chapter dates) -->
		<LinearLayout
			android:id="@+id/layout_upcoming_header"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingEnd="8dp"
			android:visibility="gone">

			<TextView
				style="@style/TextAppearance.Hanten.Today.Section"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/upcoming_title" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_upcoming_all"
				style="@style/Widget.Material3.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="@string/today_all" />
		</LinearLayout>

		<com.google.android.material.card.MaterialCardView
			android:id="@+id/card_upcoming"
			style="@style/Widget.Material3.CardView.Filled"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="16dp"
			android:visibility="gone"
			app:cardBackgroundColor="?colorSurfaceContainerLow"
			app:cardCornerRadius="20dp">

			<LinearLayout
				android:id="@+id/layout_upcoming_rows"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingVertical="4dp" />
		</com.google.android.material.card.MaterialCardView>

		<LinearLayout
			android:id="@+id/layout_recent_header"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingEnd="8dp">

			<TextView
				android:id="@+id/text_recent_title"
				style="@style/TextAppearance.Hanten.Today.Section"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/today_recent" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_recent_all"
				style="@style/Widget.Material3.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="@string/today_all" />
		</LinearLayout>

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recycler_recent"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:clipToPadding="false"
			android:orientation="horizontal"
			android:paddingHorizontal="10dp"
			app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

		<LinearLayout
			android:id="@+id/layout_empty"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:paddingHorizontal="32dp"
			android:paddingTop="96dp"
			android:visibility="gone">

			<ImageView
				android:layout_width="128dp"
				android:layout_height="128dp"
				android:importantForAccessibility="no"
				android:src="@mipmap/ic_launcher" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:gravity="center"
				android:text="@string/today_empty_title"
				android:textAppearance="?textAppearanceTitleMedium" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:gravity="center"
				android:text="@string/today_empty_hint"
				android:textAppearance="?textAppearanceBodyMedium"
				android:textColor="?colorOnSurfaceVariant" />
		</LinearLayout>
	</LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
