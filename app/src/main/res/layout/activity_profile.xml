<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/appbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@android:color/transparent"
		android:fitsSystemWindows="false"
		app:liftOnScroll="false">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			app:title="@string/profile_title">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_edit"
				style="@style/Widget.Material3.Button.TonalButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end"
				android:layout_marginEnd="12dp"
				android:text="@string/profile_edit" />
		</com.google.android.material.appbar.MaterialToolbar>
	</com.google.android.material.appbar.AppBarLayout>

	<androidx.core.widget.NestedScrollView
		android:id="@+id/scrollView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">

		<LinearLayout
			android:id="@+id/layout_content"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="16dp"
			android:paddingBottom="24dp">

			<!-- Header: banner in the profile color, avatar, nickname -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_header"
				style="@style/Widget.Hanten.CardView"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardCornerRadius="24dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">

					<View
						android:id="@+id/view_banner"
						android:layout_width="match_parent"
						android:layout_height="88dp" />

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="-40dp"
						android:gravity="bottom"
						android:orientation="horizontal"
						android:paddingHorizontal="16dp"
						android:paddingBottom="16dp">

						<TextView
							android:id="@+id/text_avatar"
							android:layout_width="80dp"
							android:layout_height="80dp"
							android:background="@drawable/bg_profile_avatar"
							android:gravity="center"
							android:importantForAccessibility="no"
							android:textColor="@android:color/white"
							android:textSize="32sp"
							android:textStyle="bold"
							tools:text="К" />

						<LinearLayout
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginStart="14dp"
							android:layout_marginTop="46dp"
							android:layout_weight="1"
							android:orientation="vertical">

							<TextView
								android:id="@+id/text_name"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:ellipsize="end"
								android:singleLine="true"
								android:textAppearance="?textAppearanceTitleLarge"
								tools:text="Nickname" />

							<TextView
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:text="@string/profile_local_hint"
								android:textAppearance="?textAppearanceBodySmall"
								android:textColor="?colorOnSurfaceVariant" />
						</LinearLayout>
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<!-- Edit panel: nickname, avatar, color (shown by the Edit button) -->
			<LinearLayout
				android:id="@+id/layout_edit"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:orientation="vertical"
				android:visibility="gone"
				tools:visibility="visible">

				<TextView
					style="@style/Widget.Hanten.TextView.ProfileSection"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/profile_appearance" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/button_name"
					style="@style/Widget.Material3.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="@string/profile_change_name" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="@string/profile_avatar"
					android:textAppearance="?textAppearanceLabelLarge"
					android:textColor="?colorOnSurfaceVariant" />

				<LinearLayout
					android:id="@+id/layout_avatars"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:orientation="horizontal" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="@string/profile_color"
					android:textAppearance="?textAppearanceLabelLarge"
					android:textColor="?colorOnSurfaceVariant" />

				<LinearLayout
					android:id="@+id/layout_colors"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:orientation="horizontal" />
			</LinearLayout>

			<!-- Stats from the device: reading time, pages, titles in the library -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:baselineAligned="false"
				android:orientation="horizontal">

				<include
					android:id="@+id/stat_hours"
					layout="@layout/item_profile_stat"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1" />

				<include
					android:id="@+id/stat_pages"
					layout="@layout/item_profile_stat"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginHorizontal="8dp"
					android:layout_weight="1" />

				<include
					android:id="@+id/stat_titles"
					layout="@layout/item_profile_stat"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1" />
			</LinearLayout>

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_stats"
				style="@style/Widget.Material3.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end"
				android:text="@string/reading_stats" />

			<TextView
				android:id="@+id/text_genres_title"
				style="@style/Widget.Hanten.TextView.ProfileSection"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/profile_genres" />

			<com.google.android.material.chip.ChipGroup
				android:id="@+id/chips_genres"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp" />

			<TextView
				android:id="@+id/text_genres_hint"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/profile_genres_hint"
				android:textAppearance="?textAppearanceBodySmall"
				android:textColor="?colorOnSurfaceVariant" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:text="@string/profile_footer"
				android:textAppearance="?textAppearanceBodySmall"
				android:textColor="?colorOnSurfaceVariant" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
