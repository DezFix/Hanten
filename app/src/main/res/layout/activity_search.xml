<?xml version="1.0" encoding="utf-8"?>
<!-- Hanten 3.0 search results: editable query field + chips for the search kind and filters,
     then rows of results per source (same cards as the library). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/appbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?android:attr/colorBackground"
		android:fitsSystemWindows="false"
		app:elevation="0dp"
		app:liftOnScroll="false">

		<LinearLayout
			android:id="@+id/layout_header"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			app:layout_scrollFlags="scroll|enterAlways">

			<com.google.android.material.appbar.MaterialToolbar
				android:id="@id/toolbar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:minHeight="64dp"
				app:contentInsetStartWithNavigation="0dp">

				<!-- the query, editable right here: Enter searches again -->
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="52dp"
					android:layout_marginEnd="16dp"
					android:background="@drawable/bg_search_field"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="16dp"
					android:paddingEnd="8dp">

					<ImageView
						android:layout_width="22dp"
						android:layout_height="22dp"
						android:importantForAccessibility="no"
						android:src="@drawable/ic_search"
						app:tint="?colorOnSurfaceVariant" />

					<EditText
						android:id="@+id/edit_query"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:layout_marginStart="10dp"
						android:layout_weight="1"
						android:background="@null"
						android:hint="@string/search_field_hint"
						android:imeOptions="actionSearch"
						android:importantForAutofill="no"
						android:inputType="text"
						android:maxLines="1"
						android:textAppearance="?textAppearanceBodyLarge"
						tools:text="Королева" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/button_clear"
						style="?materialIconButtonStyle"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:contentDescription="@string/clear"
						app:icon="@drawable/abc_ic_clear_material" />
				</LinearLayout>
			</com.google.android.material.appbar.MaterialToolbar>

			<HorizontalScrollView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:paddingHorizontal="16dp"
				android:paddingBottom="6dp"
				android:scrollbars="none">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal">

					<com.google.android.material.chip.ChipGroup
						android:id="@+id/chips_kind"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						app:selectionRequired="true"
						app:singleLine="true"
						app:singleSelection="true">

						<com.google.android.material.chip.Chip
							android:id="@+id/chip_kind_simple"
							style="@style/Widget.Hanten.Chip.Filter"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/search_kind_everywhere" />

						<com.google.android.material.chip.Chip
							android:id="@+id/chip_kind_title"
							style="@style/Widget.Hanten.Chip.Filter"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/name" />

						<com.google.android.material.chip.Chip
							android:id="@+id/chip_kind_author"
							style="@style/Widget.Hanten.Chip.Filter"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/author" />

						<com.google.android.material.chip.Chip
							android:id="@+id/chip_kind_tag"
							style="@style/Widget.Hanten.Chip.Filter"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/genre" />
					</com.google.android.material.chip.ChipGroup>

					<View
						android:layout_width="1dp"
						android:layout_height="24dp"
						android:layout_gravity="center_vertical"
						android:layout_marginHorizontal="10dp"
						android:background="?colorOutlineVariant" />

					<com.google.android.material.chip.ChipGroup
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						app:singleLine="true">

						<com.google.android.material.chip.Chip
							android:id="@+id/chip_pinned_only"
							style="@style/Widget.Hanten.Chip.Filter"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/pinned_sources_only" />

						<com.google.android.material.chip.Chip
							android:id="@+id/chip_hide_empty"
							style="@style/Widget.Hanten.Chip.Filter"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:checked="true"
							android:text="@string/hide_empty_sources" />
					</com.google.android.material.chip.ChipGroup>
				</LinearLayout>
			</HorizontalScrollView>
		</LinearLayout>
	</com.google.android.material.appbar.AppBarLayout>

	<hanten.wre.app.core.ui.list.fastscroll.FastScrollRecyclerView
		android:id="@id/recyclerView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
		app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
