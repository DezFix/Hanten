<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/toggle_mode"
		style="@style/Widget.Hanten.SegmentedGroup"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginTop="4dp"
		android:layout_marginBottom="4dp"
		app:selectionRequired="true"
		app:singleSelection="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_mode_folders"
			style="@style/Widget.Hanten.Button.Segment"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/library_folders" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_mode_all"
			style="@style/Widget.Hanten.Button.Segment"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/library_all_titles" />
	</com.google.android.material.button.MaterialButtonToggleGroup>

	<!-- "All titles": sort (opens the sort sheet) and view mode grid / list / detailed -->
	<LinearLayout
		android:id="@+id/layout_list_controls"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="4dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:visibility="gone">

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_sort"
		style="@style/Widget.Material3.Button.TextButton.Icon"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:ellipsize="end"
		android:gravity="start|center_vertical"
		android:paddingStart="4dp"
		android:singleLine="true"
		android:text="@string/sort_order"
		android:textColor="?colorOnSurface"
		app:icon="@drawable/ic_sort"
		app:iconTint="?colorOnSurface" />

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/toggle_view"
		style="@style/Widget.Hanten.SegmentedGroup"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:selectionRequired="true"
		app:singleSelection="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_view_grid"
			style="@style/Widget.Hanten.Button.Segment.Icon"
			android:layout_width="44dp"
			android:layout_height="wrap_content"
			android:contentDescription="@string/grid"
			app:icon="@drawable/ic_grid" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_view_list"
			style="@style/Widget.Hanten.Button.Segment.Icon"
			android:layout_width="44dp"
			android:layout_height="wrap_content"
			android:contentDescription="@string/list"
			app:icon="@drawable/ic_list" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/button_view_detailed"
			style="@style/Widget.Hanten.Button.Segment.Icon"
			android:layout_width="44dp"
			android:layout_height="wrap_content"
			android:contentDescription="@string/detailed_list"
			app:icon="@drawable/ic_list_detailed" />
	</com.google.android.material.button.MaterialButtonToggleGroup>
	</LinearLayout>

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recycler_folders"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:paddingHorizontal="10dp"
			android:paddingBottom="88dp" />

		<androidx.fragment.app.FragmentContainerView
			android:id="@+id/container_all"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone" />
	</FrameLayout>
</LinearLayout>
