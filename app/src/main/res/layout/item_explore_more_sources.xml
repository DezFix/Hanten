<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingTop="16dp"
	android:paddingBottom="8dp">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingHorizontal="4dp"
		android:text="@string/catalog_more_sources"
		android:textAllCaps="true"
		android:textAppearance="?textAppearanceLabelMedium"
		android:textColor="?colorOnSurfaceVariant" />

	<TextView
		android:id="@+id/row_catalog"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:layout_marginTop="8dp"
		android:background="@drawable/bg_search_field"
		android:gravity="center_vertical"
		android:paddingHorizontal="16dp"
		android:text="@string/catalog_builtin_sources"
		android:textAppearance="?textAppearanceTitleSmall" />

	<TextView
		android:id="@+id/row_extensions"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:layout_marginTop="8dp"
		android:background="@drawable/bg_search_field"
		android:gravity="center_vertical"
		android:paddingHorizontal="16dp"
		android:text="@string/catalog_extensions"
		android:textAppearance="?textAppearanceTitleSmall" />

	<TextView
		android:id="@+id/row_manage"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:layout_marginTop="8dp"
		android:background="@drawable/bg_search_field"
		android:gravity="center_vertical"
		android:paddingHorizontal="16dp"
		android:text="@string/manage_sources"
		android:textAppearance="?textAppearanceTitleSmall" />
</LinearLayout>
